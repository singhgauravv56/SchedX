# ==============================================================================
# SchedX — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your project-specific values.
# NEVER commit the real .env file or real credentials to GitHub.
# ==============================================================================

# Supabase PostgreSQL Configuration (Dual-tier persistence)
# Required if using Supabase; if omitted, SchedX automatically falls back to local JSON store.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-anon-key-here

# Server Configuration
PORT=3000
NODE_ENV=development
